# ============================================================
#  Copiez ce fichier en ".env" à la racine de backend/ et remplissez
#  les valeurs réelles. NE JAMAIS committer le fichier ".env".
# ============================================================

# Port d'écoute du backend (le frontend attend http://localhost:4000/api par défaut)
SERVER_PORT=4000

# ── Connexion PostgreSQL Supabase ────────────────────────────
# Récupérable dans Supabase -> Project Settings -> Database -> Connection string (JDBC)
# IMPORTANT: Spring Boot attend une URL JDBC complète `jdbc:postgresql://host:port/db`.
# Si Supabase fournit une URL non-JDBC (commençant par `postgresql://`), remplacez
# le préfixe par `jdbc:postgresql://` ou utilisez séparément `DB_USERNAME`/`DB_PASSWORD`.
DB_URL=jdbc:postgresql://<votre-projet>.pooler.supabase.com:6543/postgres?prepareThreshold=0
DB_USERNAME=postgres.<votre-projet>
DB_PASSWORD=<votre-mot-de-passe-supabase>

# Ne JAMAIS mettre "update"/"create" en production : le schéma est géré par database/schema.sql
JPA_DDL_AUTO=validate
JPA_SHOW_SQL=false

# ── JWT ───────────────────────────────────────────────────────
# Générez une chaîne aléatoire d'au moins 32 caractères, par ex. avec :
#   openssl rand -base64 48
JWT_SECRET=<generez-un-secret-aleatoire-avec-openssl-rand--base64-48>
# Durée de validité du token, en millisecondes (7 jours par défaut)
JWT_EXPIRATION_MS=604800000

# ── CORS ──────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173

# URL publique du frontend (sert à construire le lien QR "verify_url" des reçus)
#FRONTEND_URL=http://localhost:3000

